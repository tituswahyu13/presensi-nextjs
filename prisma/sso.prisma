generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma-sso/client"
}

datasource db {
  provider = "mysql"
  url      = env("SSO_DATABASE_URL")
}

model users {
  id                 Int                  @id @default(autoincrement())
  id_pegawai         Int?
  username           String?              @db.VarChar(50)
  password           String?              @db.VarChar(255)
  status             String?              @db.VarChar(50)
  role               String?              @db.VarChar(50)
  ruang              String?              @db.VarChar(2)
  remember_me_tokens remember_me_tokens[]
}

model remember_me_tokens {
  id         Int      @id @default(autoincrement())
  user_id    Int
  token      String   @unique(map: "token") @db.VarChar(64)
  expires_at DateTime @db.DateTime(0)
  created_at DateTime @default(now()) @db.Timestamp(0)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "FK_remember_me_users")

  @@index([user_id], map: "FK_remember_me_users")
}

model modules {
  id                 Int                  @id @default(autoincrement())
  nama_modul         String               @db.VarChar(100)
  kode_modul         String               @unique @db.VarChar(50)
  url                String               @db.VarChar(255)
  icon               String?              @db.VarChar(50)
  role_module_access role_module_access[]
}

model role_module_access {
  id       Int     @id @default(autoincrement())
  role     String  @db.VarChar(50)
  id_modul Int
  modules  modules @relation(fields: [id_modul], references: [id], onDelete: Cascade, map: "FK_role_module")

  @@unique([role, id_modul], map: "UK_role_modul")
}
